# STUB — rename to putnam_factored.yaml once the dataset is chosen (see README.md).
# .disabled suffix keeps lm-eval from indexing it.
task: putnam_factored
dataset_path: TODO/putnam-axiom-or-curated-subset
output_type: generate_until
test_split: test
num_fewshot: 0
doc_to_text: "Problem: {{problem}}\nAnswer:"
doc_to_target: "{{answer}}"        # gold factored answer, answer-matched not proof-checked
# process_docs: !function utils.process_docs   # add if factored-answer filtering is a row predicate
generation_kwargs:
  until: ["Problem:"]
  do_sample: false
  temperature: 0.0
metric_list:
  - metric: exact_match
    aggregation: mean
    higher_is_better: true
metadata:
  version: 0.0
